IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Run &new task...", ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "E&nd task\tDel", IDM_ENDTASK
        MENUITEM SEPARATOR
        MENUITEM "E&xit", ID_FILE_EXIT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "Always on &top", ID_OPTIONS_TOPMOST
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Refresh now", ID_VIEW_REFRESH
        POPUP "Update &speed"
        BEGIN
            MENUITEM "&High", ID_VIEW_UPDATESPEED_HIGH
            MENUITEM "&Normal", ID_VIEW_UPDATESPEED_NORMAL
            MENUITEM "&Low", ID_VIEW_UPDATESPEED_LOW
            MENUITEM "&Paused", ID_VIEW_UPDATESPEED_PAUSED
        END
        POPUP "CPU &graphs"
        BEGIN
            MENUITEM "&Overall (single graph)", ID_VIEW_CPU_GRAPH_OVERALL
            MENUITEM "&Per logical processor", ID_VIEW_CPU_GRAPH_PERCPU
        END
    END
END

IDR_PROC_MENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Run new &task...", ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "End &Task", IDM_ENDTASK
    END
END
