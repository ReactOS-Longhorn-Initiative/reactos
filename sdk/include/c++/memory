#pragma once
#include <stlport/memory>


#include <cstddef> // for std::size_t
#include <utility> // for std::exchange

namespace std
{

    template <typename T>
class unique_ptr {
private:
    T* ptr;

public:
    // Constructors
    constexpr unique_ptr() noexcept : ptr(nullptr) {}
    explicit unique_ptr(T* p) noexcept : ptr(p) {}

    // Move constructor
    unique_ptr(unique_ptr&& other) noexcept : ptr(other.ptr) {
        other.ptr = nullptr;
    }

    // Move assignment
    unique_ptr& operator=(unique_ptr&& other) noexcept {
        if (this != &other) {
            reset();
            ptr = other.ptr;
            other.ptr = nullptr;
        }
        return *this;
    }

    // Destructor
    ~unique_ptr() {
        delete ptr;
    }

    // Disable copy constructor and copy assignment
    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    // Member access
    T& operator*() const noexcept {
        return *ptr;
    }

    T* operator->() const noexcept {
        return ptr;
    }

    T* get() const noexcept {
        return ptr;
    }

    // Release ownership
    T* release() noexcept {
        T* old_ptr = ptr;
        ptr = nullptr;
        return old_ptr;
    }

    // Replace owned object
    void reset(T* p = nullptr) noexcept {
        if (ptr != p) {
            delete ptr;
            ptr = p;
        }
    }

    explicit operator bool() const noexcept {
        return ptr != nullptr;
    }
};

// Factory function like std::make_unique
template <typename T, typename... Args>
unique_ptr<T> make_unique(Args&&... args) {
    return unique_ptr<T>(new T(std::forward<Args>(args)...));
}


template <typename T>
class shared_ptr {
private:
    T* ptr = nullptr;
    size_t* ref_count = nullptr;

    void release() {
        if (ref_count && --(*ref_count) == 0) {
            delete ptr;
            delete ref_count;
        }
    }

public:
    shared_ptr() noexcept = default;

    explicit shared_ptr(T* p) : ptr(p), ref_count(new size_t(1)) {}

    shared_ptr(const shared_ptr& other) noexcept
        : ptr(other.ptr), ref_count(other.ref_count) {
        if (ref_count) ++(*ref_count);
    }

    template <class U>
    shared_ptr(const shared_ptr<U>& other) noexcept
        : ptr(other.ptr), ref_count(other.ref_count) {
        if (ref_count) ++(*ref_count);
    }

    shared_ptr(shared_ptr&& other) noexcept
        : ptr(other.ptr), ref_count(other.ref_count) {
        other.ptr = nullptr;
        other.ref_count = nullptr;
    }

    template <class U>
    shared_ptr(shared_ptr<U>&& other) noexcept
        : ptr(other.ptr), ref_count(other.ref_count) {
        other.ptr = nullptr;
        other.ref_count = nullptr;
    }

    ~shared_ptr() {
        release();
    }

    // Copy assignment
    shared_ptr& operator=(const shared_ptr& other) noexcept {
        if (this != &other) {
            release();
            ptr = other.ptr;
            ref_count = other.ref_count;
            if (ref_count) ++(*ref_count);
        }
        return *this;
    }

    // Cross-type copy assignment
    template <class U>
    shared_ptr& operator=(const shared_ptr<U>& other) noexcept {
        release();
        ptr = other.ptr;
        ref_count = other.ref_count;
        if (ref_count) ++(*ref_count);
        return *this;
    }

    // Move assignment
    shared_ptr& operator=(shared_ptr&& other) noexcept {
        if (this != &other) {
            release();
            ptr = other.ptr;
            ref_count = other.ref_count;
            other.ptr = nullptr;
            other.ref_count = nullptr;
        }
        return *this;
    }

    // Cross-type move assignment
    template <class U>
    shared_ptr& operator=(shared_ptr<U>&& other) noexcept {
        release();
        ptr = other.ptr;
        ref_count = other.ref_count;
        other.ptr = nullptr;
        other.ref_count = nullptr;
        return *this;
    }

    // Assign from nullptr
    shared_ptr& operator=(std::nullptr_t) noexcept {
        release();
        ptr = nullptr;
        ref_count = nullptr;
        return *this;
    }

    // Assign from std::unique_ptr (move only)
    template <class U, class D>
    shared_ptr& operator=(std::unique_ptr<U, D>&& other) {
        release();
        ptr = other.release();
        ref_count = new size_t(1);
        return *this;
    }

    // Assign from std::auto_ptr (deprecated, for compatibility)
    template <class U>
    shared_ptr& operator=(std::auto_ptr<U>&& other) {
        release();
        ptr = other.release();
        ref_count = new size_t(1);
        return *this;
    }

    T* get() const noexcept { return ptr; }
    T& operator*() const noexcept { return *ptr; }
    T* operator->() const noexcept { return ptr; }

    size_t use_count() const noexcept { return ref_count ? *ref_count : 0; }
    explicit operator bool() const noexcept { return ptr != nullptr; }

    template <typename U>
    friend class shared_ptr;
};
}