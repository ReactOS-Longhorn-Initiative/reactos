#pragma once
#include "../../../sdk/include/c++/stlport/type_traits"

namespace std
{
    // Primary template — not defined
template<typename T, bool = __is_enum(T)>
struct underlying_type;  // undefined for non-enums

// Specialization for enums
template<typename T>
struct underlying_type<T, true> {
    using type = __underlying_type(T);
};

// Helper alias
template<typename T>
using underlying_type_t = typename underlying_type<T>::type;

// Primary template: no member 'type' if condition is false
template<bool B, typename T = void>
struct enable_if {};

// Specialization: defines 'type' if condition is true
template<typename T>
struct enable_if<true, T> {
    using type = T;
};

// Primary template: defaults to false
template<typename T>
struct is_pointer {
    static const bool value = false;
};

// Specialization for T*
template<typename T>
struct is_pointer<T*> {
    static const bool value = true;
};

// Optional helper for T* const, T* volatile, T* const volatile
template<typename T>
struct is_pointer<T* const> {
    static const bool value = true;
};

template<typename T>
struct is_pointer<T* volatile> {
    static const bool value = true;
};

template<typename T>
struct is_pointer<T* const volatile> {
    static const bool value = true;
};

// Primary template - defaults to false
template<typename T>
struct is_function : std::false_type {};

// Specialization for function types (including pointers to functions)
template<typename R, typename... Args>
struct is_function<R(Args...)> : std::true_type {};

// Specialization for function pointers
template<typename R, typename... Args>
struct is_function<R(*)(Args...)> : std::true_type {};

// Optional specialization for const and volatile function pointers
template<typename R, typename... Args>
struct is_function<R(*const)(Args...)> : std::true_type {};

template<typename R, typename... Args>
struct is_function<R(*volatile)(Args...)> : std::true_type {};

template<typename R, typename... Args>
struct is_function<R(*const volatile)(Args...)> : std::true_type {};

// Primary template - handles the case when T is not a pointer
template<typename T>
struct remove_pointer {
    using type = T;  // If T is not a pointer, just return T itself
};

// Specialization for pointer types
template<typename T>
struct remove_pointer<T*> {
    using type = T;  // If T is a pointer, remove the pointer
};

// Primary template for integral_constant
template<typename T, T v>
struct integral_constant {
    static constexpr T value = v;  // The constant value

    // Type alias for easier access to the value
    using value_type = T;
    using type = integral_constant<T, v>;  // Alias to the type itself
};

// Some commonly used integral constants
using std::integral_constant; // forward declaration for regular use.

struct false_type : std::integral_constant<bool, false> {};
struct true_type : std::integral_constant<bool, true> {};

// Primary template for is_same
template<typename T, typename U>
struct is_same : std::false_type {};

// Specialization for when T and U are the same type
template<typename T>
struct is_same<T, T> : std::true_type {};

namespace detail
{
    template<class T>
    struct type_identity { using type = T; }; // or use std::type_identity (since C++20)
 
    template<class T> // Note that “cv void&” is a substitution failure
    auto try_add_lvalue_reference(int) -> type_identity<T&>;
    template<class T> // Handle T = cv void case
    auto try_add_lvalue_reference(...) -> type_identity<T>;
 
    template<class T>
    auto try_add_rvalue_reference(int) -> type_identity<T&&>;
    template<class T>
    auto try_add_rvalue_reference(...) -> type_identity<T>;
} // namespace detail
 
template<class T>
struct add_lvalue_reference
    : decltype(detail::try_add_lvalue_reference<T>(0)) {};
 
template<class T>
struct add_rvalue_reference
    : decltype(detail::try_add_rvalue_reference<T>(0)) {};

     // Yes/No types to differentiate overloads
     typedef char yes_type;
     struct no_type { char dummy[2]; };
 
     // Helper to test if conversion is possible
     template <typename From, typename To>
     class is_convertible {
         // Test function that returns yes_type if implicit conversion works
         static yes_type test(To);
 
         // Fallback if conversion fails
         static no_type test(...);
 
         // Use decltype to see which overload is picked
         static From makeFrom();
 
     public:
         static constexpr bool value = sizeof(test(makeFrom())) == sizeof(yes_type);
     };
 

     template<typename T>
struct is_arithmetic_helper : std::false_type {};

#define DEFINE_ARITHMETIC_TYPE(T)       \
    template<>                          \
    struct is_arithmetic_helper<T> : std::true_type {};

DEFINE_ARITHMETIC_TYPE(bool)
DEFINE_ARITHMETIC_TYPE(char)
DEFINE_ARITHMETIC_TYPE(signed char)
DEFINE_ARITHMETIC_TYPE(unsigned char)
DEFINE_ARITHMETIC_TYPE(wchar_t)
DEFINE_ARITHMETIC_TYPE(char16_t)
DEFINE_ARITHMETIC_TYPE(char32_t)
DEFINE_ARITHMETIC_TYPE(short)
DEFINE_ARITHMETIC_TYPE(unsigned short)
DEFINE_ARITHMETIC_TYPE(int)
DEFINE_ARITHMETIC_TYPE(unsigned int)
DEFINE_ARITHMETIC_TYPE(long)
DEFINE_ARITHMETIC_TYPE(unsigned long)
DEFINE_ARITHMETIC_TYPE(long long)
DEFINE_ARITHMETIC_TYPE(unsigned long long)
DEFINE_ARITHMETIC_TYPE(float)
DEFINE_ARITHMETIC_TYPE(double)
DEFINE_ARITHMETIC_TYPE(long double)

#undef DEFINE_ARITHMETIC_TYPE

template<typename T>
struct remove_const {
    typedef T type;
};

template<typename T>
struct remove_const<const T> {
    typedef T type;
};

// remove volatile
template<typename T>
struct remove_volatile {
    typedef T type;
};

template<typename T>
struct remove_volatile<volatile T> {
    typedef T type;
};

// remove both const and volatile
template<typename T>
struct remove_cv {
    typedef typename remove_volatile<typename remove_const<T>::type>::type type;
};


template<typename T>
struct is_arithmetic : is_arithmetic_helper<typename std::remove_cv<T>::type> {};
}