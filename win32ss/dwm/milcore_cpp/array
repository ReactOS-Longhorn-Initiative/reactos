template <size_t I, typename T, size_t N>
T& get(array<T, N>& arr) noexcept {
    static_assert(I < N, "Index out of bounds");
    return arr[I];
}

template <size_t I, typename T, size_t N>
const T& get(const array<T, N>& arr) noexcept {
    static_assert(I < N, "Index out of bounds");
    return arr[I];
}

